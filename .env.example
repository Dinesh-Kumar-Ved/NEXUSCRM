# ==============================================================================
# NexusCRM Environment Configuration Template
# Copy this file to .env and provide your actual credentials.
# NEVER commit real API keys, secrets, or access tokens to version control.
# ==============================================================================

# Supabase Connectivity
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 1. Google OAuth 2.0 & Gmail API (Official Gmail Connection - Recommended)
# ------------------------------------------------------------------------------
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/oauth/callback

# 32-byte (256-bit) Base64-encoded encryption key for AES-256-GCM token storage
# Generate via: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 2. WhatsApp Business Platform / Meta WhatsApp Cloud API
# ------------------------------------------------------------------------------
# Obtain from Meta for Developers (developers.facebook.com) -> WhatsApp -> API Setup
# Phone Number ID (Numeric ID, e.g. 104829103849102)
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA ID, e.g. 109283746192834)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Meta Permanent System User Access Token (or temporary token for testing)
WHATSAPP_ACCESS_TOKEN=

# Webhook verification token (optional, for receiving inbound webhook events)
WHATSAPP_VERIFY_TOKEN=

# ------------------------------------------------------------------------------
# 3. Alternative Email Providers (Optional)
# ------------------------------------------------------------------------------
# Resend
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME="NexusCRM Support"

# SMTP (Custom / Outlook)
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASSWORD=your-password
# EMAIL_SECURE=false

# SendGrid
# SENDGRID_API_KEY=SG...
